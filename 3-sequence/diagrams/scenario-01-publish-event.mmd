sequenceDiagram
    autonumber
    actor BM as Band Member
    participant UI as WebClient
    participant API as EventController
    participant ES as EventService
    participant BR as BandRepository
    participant ER as EventRepository
    Note over BM,ER: Scenario 1 - Band publishes a valid Event
    BM->>UI: submitEventForm(details)
    activate UI
    UI->>API: POST /bands/1/events
    activate API
    API->>ES: publishEvent(bandId, details)
    activate ES
    ES->>BR: findById(bandId)
    activate BR
    BR-->>ES: Band(profileComplete=true)
    deactivate BR
    ES->>ES: validateEventDetails(details)
    alt details valid and Band profile complete
        ES->>ER: save(Event(capacity, status=published))
        activate ER
        ER-->>ES: Event(id, band_id, capacity)
        deactivate ER
        ES-->>API: EventPublished(event)
        API-->>UI: 201 Created
        UI-->>BM: showPublishedEvent(event)
    else validation fails
        ES-->>API: ValidationError(errors)
        API-->>UI: 422 Unprocessable Entity
        UI-->>BM: showValidationErrors(errors)
    end
    deactivate ES
    deactivate API
    deactivate UI