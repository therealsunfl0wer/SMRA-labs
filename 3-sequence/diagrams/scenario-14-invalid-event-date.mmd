sequenceDiagram
    autonumber
    actor BM as Band Member
    participant UI as WebClient
    participant API as EventController
    participant ES as EventService
    participant ER as EventRepository
    Note over BM,ER: Scenario 14 - Event with a past or invalid date is rejected
    BM->>UI: submitEventForm(date)
    activate UI
    UI->>API: POST /bands/{id}/events
    activate API
    API->>ES: publishEvent(bandId, details)
    activate ES
    ES->>ES: parseIsoDate(date)
    alt date format is invalid
        ES-->>API: ValidationError(INVALID_DATE_FORMAT)
        API-->>UI: 422 Unprocessable Entity
        UI-->>BM: showError("Invalid date format")
    else date is not in the future
        ES-->>API: ValidationError(EVENT_DATE_NOT_FUTURE)
        API-->>UI: 422 Unprocessable Entity
        UI-->>BM: showError("Event date must be in the future")
    else date is valid and future
        ES->>ER: save(Event(details))
        activate ER
        ER-->>ES: Event(id)
        deactivate ER
        ES-->>API: EventPublished(id)
        API-->>UI: 201 Created
        UI-->>BM: showSuccess()
    end
    deactivate ES
    deactivate API
    deactivate UI